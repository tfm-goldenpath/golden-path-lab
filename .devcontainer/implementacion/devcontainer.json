{
  "name": "Golden Path - implementation",
  "build": {
    "dockerfile": "../../implementacion/.devcontainer/Dockerfile",
    "context": "../../implementacion"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "version": "29.8.0",
      "moby": false,
      "installDockerBuildx": false,
      "dockerDashComposeVersion": "none",
      "installDockerComposeSwitch": false
    }
  },
  "remoteUser": "node",
  "containerEnv": {
    "KIND_EXPERIMENTAL_PROVIDER": "docker"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "npm ci --prefix implementacion/tooling --ignore-scripts --no-audit --no-fund && bash implementacion/scripts/check-environment.sh --tools-only",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  }
}
